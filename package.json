{
  "name": "cocos-challenge-backend",
  "version": "0.1.0",
  "private": true,
  "description": "API de portfolio, instrumentos y órdenes (challenge Cocos)",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "TS_NODE_BASEURL=./dist node -r tsconfig-paths/register dist/main.js",
    "start:dev": "ts-node -r tsconfig-paths/register src/main.ts",
    "lint": "eslint .",
    "test": "npm run test:unit",
    "test:all": "npm run test:unit && npm run test:integration",
    "test:unit": "jest --selectProjects unit",
    "test:integration": "jest --selectProjects integration --runInBand",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:migrate": "ts-node -r tsconfig-paths/register src/migrate-schema.ts",
    "db:migrate:revert": "ts-node -r tsconfig-paths/register src/migrate-schema.ts --revert",
    "migrate:legacy": "ts-node -r tsconfig-paths/register src/migrate.ts",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d --wait",
    "db:setup": "npm run db:migrate && npm run migrate:legacy"
  },
  "dependencies": {
    "@nestjs/common": "^12.4.2",
    "@nestjs/core": "^12.4.2",
    "@nestjs/platform-fastify": "^12.4.2",
    "@nestjs/swagger": "^12.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "decimal.js": "^10.6.0",
    "dotenv": "^18.0.10",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tsconfig-paths": "^4.2.0",
    "typeorm": "^1.1.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@nestjs/testing": "^12.4.2",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "eslint": "^9.39.5",
    "eslint-plugin-sonarjs": "^4.2.2",
    "jest": "^29.7.0",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2"
  }
}
