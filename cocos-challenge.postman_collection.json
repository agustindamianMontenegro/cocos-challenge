{
  "info": {
    "name": "Cocos Challenge — Backend",
    "description": "API de portfolio, instrumentos y órdenes.\n\nAntes: `npm run db:up`, `npm run db:setup` y `npm run start:dev`.\n\nCada pedido de orden genera su propio UUIDv7 ({{newOrderId}}), así que la colección se puede correr completa varias veces (Run collection). Cada pedido tiene pruebas de la respuesta.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Genera un UUIDv7 nuevo en cada pedido: {{newOrderId}}.",
          "function uuidv7() {",
          "  const ts = Date.now().toString(16).padStart(12, '0');",
          "  const hex = (n) => Array.from({ length: n }, () => Math.floor(Math.random() * 16).toString(16)).join('');",
          "  const variant = (8 + Math.floor(Math.random() * 4)).toString(16);",
          "  return `${ts.slice(0, 8)}-${ts.slice(8, 12)}-7${hex(3)}-${variant}${hex(3)}-${hex(12)}`;",
          "}",
          "pm.variables.set('newOrderId', uuidv7());"
        ]
      }
    }
  ],
